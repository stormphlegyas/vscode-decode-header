{
  "name": "decodeheader",
  "displayName": "Decode Header",
  "description": "Decode school header for VSCode : ecole-decode.fr",
  "version": "1.0.1",
  "publisher": "stormphlegyas",
  "icon": "decode.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/stormphlegyas/vscode-decode-header"
  },
  "bugs": {
    "url": "https://github.com/stormphlegyas/vscode-decode-header/issues"
  },
  "homepage": "https://github.com/stormphlegyas/vscode-decode-header",
  "license": "MIT",
  "engines": {
    "vscode": "^1.6.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "decode",
    "ecole-decode",
    "header",
    "school"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "configuration": {
      "properties": {
        "decodeheader.username": {
          "type": "string",
          "description": "Username to use in Decode headers"
        },
        "decodeheader.email": {
          "type": "string",
          "description": "Email address to use in Decode headers"
        }
      }
    },
    "commands": [
      {
        "command": "decodeheader.insertHeader",
        "title": "Insert Decode header",
        "when": "editorTextFocus"
      }
    ],
    "keybindings": [
      {
        "command": "decodeheader.insertHeader",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "test": "tsc && node ./out/test/runTest.js",
    "release": "npm version patch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.15.10",
    "@types/vscode": "^1.6.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^9.3.2",
    "mocha": "^10.2.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "moment": "^2.15.0"
  }
}
